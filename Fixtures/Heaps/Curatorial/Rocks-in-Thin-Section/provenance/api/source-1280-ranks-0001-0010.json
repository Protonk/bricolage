y_%28bostonite%29_%28GeoDIL_number_-_2637%29.jpg/1280px-Trachyte_porphyry_%28bostonite%29_%28GeoDIL_number_-_2637%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":874,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/0/01/Trachyte_porphyry_%28bostonite%29_%28GeoDIL_number_-_2637%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Trachyte_porphyry_%28bostonite%29_%28GeoDIL_number_-_2637%29.jpg/1280px-Trachyte_porphyry_%28bostonite%29_%28GeoDIL_number_-_2637%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":874,"srcset":"https://upload.wikimedia.org/wikipedia/commons/0/01/Trachyte_porphyry_%28bostonite%29_%28GeoDIL_number_-_2637%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/0/01/Trachyte_porphyry_%28bostonite%29_%28GeoDIL_number_-_2637%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Trachyte_porphyry_(bostonite)_(GeoDIL_number_-_2637).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=163488176","sha1":"3f0c0b1e5033dcef0bd204fb7f16cc5dad68ab6d","extmetadata":{"DateTime":{"value":"2025-04-12 17:46:28","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Trachyte porphyry (bostonite) - Thin section of trachyte porphyry (bostonite)","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"CC-Zero|Files from external sources with reviewed licenses|Phanerozoic igneous rocks in New York (state)|Uploaded with OpenRefine|Photographs by Darla Sondrol|Igneous rocks in thin section|Bostonite|GeoDIL images|Ward's Collection of Classic North American Rocks","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q126871368\" class=\"extiw\" title=\"d:Q126871368\"><span title=\"photographer from the United States\">Darla Sondrol</span></a></bdi>","source":"commons-desc-page"},"ImageDescription":{"value":"This is a photo of a plain polarized thin section of trachyte porphyry. Prominent phenocrysts are blocky to subrounded sodic orthoclse, turbid and zoned, with some being glomeroporphyritic. The matrix consists predominantly of equigranular tablets of zoned hematitic orthoclase, euhedral and in subparallel (trachytoid) arrangement. A few original mafic grains (pyrozene?) now consist of sericite, calcite, hematite, magnetite and sphene. Abundant accessory magnetite has been altered to hematite. Interstitial accessories are widespread: anhedral quartz, amall zircon euhdra, sericite flakes and grains of calcite. Veinlets of hematite cut the rock.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"9 April 2002","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://geodil.dperkins.org/h/2637.html\">https://geodil.dperkins.org/h/2637.html</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Zero, Public Domain Dedication","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"revisions":[{"revid":1263136897,"parentid":1262695871,"timestamp":"2026-08-18T10:23:53Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"== {{int:filedesc}} ==\n{{Photograph\n | photographer       = {{Creator|wikidata=Q126871368}}\n | title              = {{en|1=Trachyte porphyry (bostonite) - Thin section of trachyte porphyry (bostonite)}}\n | description        = {{en|1=This is a photo of a plain polarized thin section of trachyte porphyry. Prominent phenocrysts are blocky to subrounded sodic orthoclse, turbid and zoned, with some being glomeroporphyritic. The matrix consists predominantly of equigranular tablets of zoned hematitic orthoclase, euhedral and in subparallel (trachytoid) arrangement. A few original mafic grains (pyrozene?) now consist of sericite, calcite, hematite, magnetite and sphene. Abundant accessory magnetite has been altered to hematite. Interstitial accessories are widespread: anhedral quartz, amall zircon euhdra, sericite flakes and grains of calcite. Veinlets of hematite cut the rock.}}\n | depicted place     = USA ▹ New York ▹ Essex. Near Essex.\n | date               = 2002-04-09\n | institution        = {{Institution:Geoscience Digital Image Library}}\n | notes              = {{en|1=419 KB. Thin section. Nikon FDX-35.}}\n | accession number   = {{en|1=GeoDIL number: 2637}}\n | source             = https://geodil.dperkins.org/h/2637.html\n | other_fields       = {{Information field|name=Collection|value={{en|1=Ward’s Collection of Classic North American Rocks #15}}}}\n {{Information field|name=Chronostratigraphy|value={{en|1=Post Ordovician}}}}\n}}\n\n== {{int:license-header}} ==\n{{Cc-zero}}\n{{LicenseReview|site=https://geodil.dperkins.org/h/2637.html|user=1Veertje|date=2026-08-18}}\n\n[[Category:GeoDIL images]]\n[[Category:Uploaded with OpenRefine]]\n[[Category:Bostonite]]\n[[Category:Igneous rocks in thin section]]\n[[Category:Phanerozoic igneous rocks in New York (state)]]\n[[Category:Photographs by Darla Sondrol]]\n[[Category:Ward's Collection of Classic North American Rocks]]"}}}]}]}}