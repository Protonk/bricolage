/1/1d/Southern_Defense_Command_SSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1d/Southern_Defense_Command_SSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Southern_Defense_Command_SSI.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=133454450","sha1":"39d4f5986ac062799435eedc50cc9f0ab0d9f30c","extmetadata":{"DateTime":{"value":"2023-06-22 18:40:14","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Southern Defense Command SSI","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Shoulder Sleeve Insignia of the United States Army (SSI)|PD US Army USAIOH|1943 works in the United States|Southern Defense Command","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Shoulder Sleeve Insignia (SSI) of the Southern Defense Command, part of the United States Army.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1943-04-20","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://tioh.army.mil/Catalog/Heraldry.aspx?HeraldryId=16115&amp;CategoryId=9322&amp;grp=2&amp;menu=Uniformed%20Services&amp;from=search\">Southern Defense Command SSI</a> from the United States Institute of Heraldry website","source":"commons-desc-page"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:United_States_Army\" class=\"extiw\" title=\"w:en:United States Army\"><span title=\"land service branch of the United States Armed Forces\">United States Army</span></a></bdi>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"revisions":[{"revid":1267026509,"parentid":1060344349,"timestamp":"2026-08-25T05:10:58Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"=={{int:filedesc}}==\n{{Information\n| description    = {{en|1=Shoulder Sleeve Insignia (SSI) of the Southern Defense Command, part of the United States Army.}}\n| date           = 1943-04-20\n| source         = [https://tioh.army.mil/Catalog/Heraldry.aspx?HeraldryId=16115&CategoryId=9322&grp=2&menu=Uniformed%20Services&from=search Southern Defense Command SSI] from the United States Institute of Heraldry website\n| author         = {{Creator:United States Army}}\n| permission     = \n| other versions = \n}}\n\n== Description ==\n'''Blazon'''\n\n''On a shield 3 1/4 inches (8.26 cm) in height and 2 1/2 inches (6.35 cm) in width per bend Gules and Azure a bend wavy 5/8 inch (1.59 cm) in width Argent''.\n\n'''Symbolism'''\n\nThe shield is representative of the defensive mission of the Southern Defense Command while the red of the shield represents the land protected and defended by the forces of the command.  The white bend is also symbolic of the protective mission of the command against attack across the frontier.  The three colors, which are also used in the insignia of the Third Army, are indicative of the formation of the Southern Defense Command out of, and its close connection with, that organization.\n\n'''Background'''\n\nThe shoulder sleeve insignia was approved on 17 April 1943.  It was amended to correct the description on 20 April 1943.\n\n=={{int:license-header}}==\n\n{{PD-USGov-Military-Army-USAIOH}}\n\n[[Category:1943 works in the United States]]\n[[Category:Shoulder Sleeve Insignia of the United States Army (SSI)]]\n[[Category:Southern Defense Command]]"}}}]},{"pageid":134169192,"ns":6,"title":"File:US Army 52nd Air Defense Artillery Brigade SSI.png","imagerepository":"local","imageinfo":[{"timestamp":"2023-06-19T22:23:55Z","user":"McChizzle","size":101325,"width":1201,"height":1801,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png/330px-US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":320,"thumbheight":480,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png/960px-US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png/330px-US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":320,"height":480,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png/960px-US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/9/9d/US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:US_Army_52nd_Air_Defense_Artillery_Brigade_SSI.png","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=134169192","sha1":"4d5614a72f15ec18975dce4c618efe1811e58036","extmetadata":{"DateTime":{"value":"2023-06-19 22:23:55","source":"mediawiki-m