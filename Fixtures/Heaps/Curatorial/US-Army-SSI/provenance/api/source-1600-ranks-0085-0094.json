ptionurl":"https://commons.wikimedia.org/wiki/File:Army_Strategic_Defense_Command_SSI.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=132523850","sha1":"56890ac885389064ebf65c0f6be12fd39c01f65e","extmetadata":{"DateTime":{"value":"2023-05-31 17:49:01","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Army Strategic Defense Command SSI","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Strategic Defense Initiative|PD US Government|Shoulder Sleeve Insignia of the United States Army (SSI)|CC-PD-Mark","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"The colors scarlet and yellow are traditionally associated with Artillery and light blue represents the sky.  The sentinel denotes readiness and alertness, representing the organization as guardian of the nation’s skies.\nThe shoulder sleeve insignia was originally approved for the Field Elements of the Sentinel System Organization on 10 January 1969.  It was redesignated for the Field Elements of the Safeguard System Organization on 8 May 1969.  It was redesignated for the Field Elements of the US Army Ballistic Missile Defense Organization on 17 July 1974.  The insignia was redesignated for the US Army Strategic Defense Command on 12 December 1985. (TIOH Dwg. No. A-1-512)","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1969-01-10","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://tioh.army.mil/Catalog/Heraldry.aspx?HeraldryId=16071&amp;CategoryId=9305&amp;grp=2&amp;menu=Uniformed%20Services&amp;from=search\">https://tioh.army.mil/Catalog/Heraldry.aspx?HeraldryId=16071&amp;CategoryId=9305&amp;grp=2&amp;menu=Uniformed%20Services&amp;from=search</a>","source":"commons-desc-page"},"Artist":{"value":"U.S. Army","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"revisions":[{"revid":911016350,"parentid":801818614,"timestamp":"2024-08-17T18:00:17Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"=={{int:filedesc}}==\n{{Information\n|description={{en|1=The colors scarlet and yellow are traditionally associated with Artillery and light blue represents the sky.  The sentinel denotes readiness and alertness, representing the organization as guardian of the nation’s skies.\n\nThe shoulder sleeve insignia was originally approved for the Field Elements of the Sentinel System Organization on 10 January 1969.  It was redesignated for the Field Elements of the Safeguard System Organization on 8 May 1969.  It was redesignated for the Field Elements of the US Army Ballistic Missile Defense Organization on 17 July 1974.  The insignia was redesignated for the US Army Strategic Defense Command on 12 December 1985. (TIOH Dwg. No. A-1-512)}}\n|date=1969-01-10\n|source=https://tioh.army.mil/Catalog/Heraldry.aspx?HeraldryId=16071&CategoryId=9305&grp=2&menu=Uniformed%20Services&from=search\n|author=U.S. Army\n|permission=\n|other versions=\n}}\n\n=={{int:license-header}}==\n{{PD-USGov}}\n\n[[Category:Shoulder Sleeve Insignia of the United States Army (SSI)]]\n[[Category:Strategic Defense Initiative]]"}}}]},{"pageid":166251246,"ns":6,"title":"File:U.S. Arctic Tab.png","imagerepository":"local","imageinfo":[{"timestamp":"2025-05-29T03:36:18Z","user":"Coldstreamer20","size":25134,"width":1350,"height":464,"thumburl":"https://upload.wikimedia.org/wikipedia/common