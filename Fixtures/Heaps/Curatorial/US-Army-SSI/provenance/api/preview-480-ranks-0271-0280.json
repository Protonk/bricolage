":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/png"}],"revisions":[{"revid":912890760,"parentid":678191135,"timestamp":"2024-08-20T08:11:01Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"<!--This file was moved here using FileImporter from //en.wikipedia.org/wiki/File:US_Army_National_Guard_Regional_Training_Institute_Shoulder_Sleeve_Insignia.png-->\n== {{int:filedesc}} ==\n{{Information\n|Description    = {{en|[[w:U.S. Army|U.S. Army]] [[w:United States Army National Guard|National Guard]] Regional Training Institute (formerly known as the Army National Guard Schools) [[w:shoulder sleeve insignia|shoulder sleeve insignia]]}}\n|Source         = https://web.archive.org/web/20161211021455/http://www.tioh.hqda.pentagon.mil/Catalog/Heraldry.aspx?HeraldryId=7536&CategoryId=4210&grp=2&menu=Uniformed%20Services\n|Author         = The Institute of Heraldry\n|Date           = 1997-10-27\n|Permission     = {{PD-USGov-Military-Army-USAIOH}}\n|other versions =\n}}\n\n[[Category:Shoulder Sleeve Insignia (SSI) of the Army National Guard]]\n[[Category:US Army Tradoc Schools Shoulder Sleeve Insignia]]"}}}]},{"pageid":192709360,"ns":6,"title":"File:US Army Combat Developments Command SSI 2026-05-24.svg","imagerepository":"local","imageinfo":[{"timestamp":"2026-05-24T02:55:08Z","user":"SergeantSelfExplanatory","size":9869,"width":500,"height":500,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/US_Army_Combat_Developments_Command_SSI_2026-05-24.svg/500px-US_Army_Combat_Developments_Command_SSI_2026-05-24.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":480,"thumbheight":480,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/US_Army_Combat_Developments_Command_SSI_2026-05-24.svg/960px-US_Army_Combat_Developments_Command_SSI_2026-05-24.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/US_Army_Combat_Developments_Command_SSI_2026-05-24.svg/500px-US_Army_Combat_Developments_Command_SSI_2026-05-24.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":480,"height":480,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/US_Army_Combat_Developments_Command_SSI_2026-05-24.svg/960px-US_Army_Combat_Developments_Command_SSI_2026-05-24.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/5/58/US_Army_Combat_Developments_Command_SSI_2026-05-24.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:US_Army_Combat_Developments_Command_SSI_2026-05-24.svg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=192709360","sha1":"c81632a5edd14520483953548381f62538f3aa57","extmetadata":{"DateTime":{"value":"2026-05-24 02:55:08","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"US Army Combat Developments Command SSI 2026-05-24","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD US Army USAIOH|Extracted images|PD-USGov missing SDC copyright status|US Army Command Shoulder Sleeve Insignia|United States Army Combat Developments Command|United States Army Combat Developments Command shoulder sleeve insignia 2026-05-24","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Shoulder_sleeve_insignia\" class=\"extiw\" title=\"w:Shoulder sleeve insignia\">Shoulder sleeve insignia</a> of the <a href=\"https://en.wikipedia.org/wiki/United_States_Army_Combat_Developments_Command\" class=\"extiw\" title=\"w:United States Army Combat Developments Command\">United States Army Combat Developments Command</a>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Blazon\"><a href=\"https://en.wikipedia.org/wiki/Blazon\" class=\"extiw\" title=\"w:Blazon\">Blazon</a></h3></div>\n<p>On a red disc 2 inches (5.08 cm) in diameter, a white arrowhead, point up, containing a blue five-pointed star, its upper point extended.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Symbolism\">Symbolism</h3></div>\n<p>The star is symbolic of command, and its extended upper point emphasizes direction and purpose. The arrowhead denotes the combat aspect of the command's operations.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Background\">Background</h3></div>\n<p>The shoulder sleeve insignia was approved for the U.S. Army Combat Developments Command on 9 July 1962. The insignia was amended to specifically authorize wear for the Office, Commanding General, United States Army Combat Developments Command and subordinate elements on 23 July 1963. The insignia was cancelled on 12 July 1973. <br>\n</p>\n(TIOH Drawing <abbr title=\"Number\">No</abbr>. A-1-299)","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1962-07-09","source":"commons-desc-page"},"Credit":{"value":"This image has been <b>extracted</b> from another file","source":"commons-desc-page"},"Artist":{"value":"United States Army","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/svg+xml"}],"revisions":[{"revid":1270590860,"parentid":1270402807,"timestamp":"2026-08-31T23:37:57Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"=={{int:filedesc}}==\n{{Information\n|description={{en|1=[[w:Shoulder sleeve insignia|Shoulder sleeve insignia]] of the [[w:United States Army Combat Developments Command|United States Army Combat Developments Command]]\n\n===[[w:Blazon|Blazon]]===\nOn a red disc 2 inches (5.08 cm) in diameter, a white arrowhead, point up, containing a blue five-pointed star, its upper point extended.\n\n===Symbolism===\nThe star is symbolic of command, and its extended upper point emphasizes direction and purpose. The arrowhead denotes the combat aspect of the command's operations.\n\n===Background===\nThe shoulder sleeve insignia was approved for the U.S. Army Combat Developments Command on 9 July 1962. The insignia was amended to specifically authorize wear for the Office, Commanding General, United States Army Combat Developments Command and subordinate elements on 23 July 1963. The insignia was cancelled on 12 July 1973. <br/>\n\n(TIOH Drawing {{abbr|No|Number}}. A-1-299)}}\n|date=1962-07-09\n|source={{extracted from|File:USACDC SSI.jpg}}\n|author={{en|1=United States Army}}\n|permission=\n|other versions=\n}}\n\n=={{int:license-header}}==\n{{PD-USGov-Military-Army-USAIOH}}\n\n[[Category:United States Army Combat Developments Command shoulder sleeve insignia 2026-05-24]]\n[[Category:United States Army Combat Developments Command]]\n[[Category:US Army Command Shoulder Sleeve Insignia|Combat Developments Command]]"}}}]}]}}