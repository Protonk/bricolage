dth":388,"height":480,"srcset":"https://upload.wikimedia.org/wikipedia/commons/f/f7/369SustBdeSSI.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/f7/369SustBdeSSI.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:369SustBdeSSI.png","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=34170222","sha1":"c4548afb3b8ef80b742165e46dcc90ae5e401193","extmetadata":{"DateTime":{"value":"2014-07-23 15:47:42","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"369SustBdeSSI","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD US Army USAIOH|Combat service identification badges of the United States Army|US Army Sustainment Brigade Shoulder Sleeve Insignia","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"369th Sustainment Brigade Shoulder Sleeve Insignia","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2008-02-07","source":"commons-desc-page"},"Credit":{"value":"US Army Institute Of Heraldry\\\\","source":"commons-desc-page"},"Artist":{"value":"U.S. Army","source":"commons-desc-page"},"Permission":{"value":"<i>This image shows a <a href=\"https://en.wikipedia.org/wiki/flag\" class=\"extiw\" title=\"en:flag\">flag</a>, a <a href=\"https://en.wikipedia.org/wiki/coat_of_arms\" class=\"extiw\" title=\"en:coat of arms\">coat of arms</a>, a <a href=\"https://en.wikipedia.org/wiki/seal_(device)\" class=\"extiw\" title=\"en:seal (device)\">seal</a> or some other official <b><a href=\"https://en.wikipedia.org/wiki/insignia\" class=\"extiw\" title=\"en:insignia\">insignia</a></b> produced by the <b><a href=\"https://en.wikipedia.org/wiki/United_States_Army_Institute_of_Heraldry\" class=\"extiw\" title=\"en:United States Army Institute of Heraldry\">United States Army Institute of Heraldry</a></b>.  It is in the <b><a href=\"https://en.wikipedia.org/wiki/public_domain\" class=\"extiw\" title=\"en:public domain\">public domain</a></b> but its use is restricted by <a rel=\"nofollow\" class=\"external text\" href=\"https://www.gpo.gov/fdsys/pkg/USCODE-2010-title18/pdf/USCODE-2010-title18-partI-chap33-sec704.pdf\">Title 18, United States Code, Section 704</a> <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://www.law.cornell.edu/uscode/text/18/704\">[1]</a> and the <a rel=\"nofollow\" class=\"external text\" href=\"https://www.gpo.gov/fdsys/granule/CFR-2012-title32-vol3/CFR-2012-title32-vol3-part507/content-detail.html\">Code of Federal Regulations (32 CFR, Part 507)</a> <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://www.ecfr.gov/cgi-bin/text-idx?mc=true&amp;node=pt32.3.507&amp;rgn=div5\">[2]</a>, <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://www.law.cornell.edu/cfr/text/32/part-507\">[3]</a>.  Permission to use these images in the USA for most commercial purposes must be obtained from The Institute of Heraldry prior to their use.</i>","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/png"}],"revisions":[{"revid":912897392,"parentid":767652608,"timestamp":"2024-08-20T08:16:50Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Information\n|Description= 369th Sustainment Brigade Shoulder Sleeve Insignia\n|Source= US Army Institute Of Heraldry\\\\\n|Date= 2008-02-07\n|Author= U.S. Army\n|Permission= {{PD-USGov-Military-Army-USAIOH}} - US Army Institute Of Heraldry\n|other_versions=\n}}\n\n[[Category:US Army Sustainment Brigade Shoulder Sleeve Insignia]]\n\n==Blazon==\n\n*Description:\n\n#A shield-shaped embroidered item, arched outwardly at top blazoned as follows:  Per chevron Argent and Gules, between three palets counterchanged, two poplar trees Vert; all with a 1/8 inch (.32 cm) Blue border.\n#Overall dimensions are 2 7/16 inches (6.19 cm) in width and 3 inches (7.62 cm) in length.   \n\n*Symbolism:\n#The chevron, heraldic symbol for support, suggests the unit’s mission.\n#The palets/vertical bars signify military strength and allude to the three campaigns in Saudi Arabia, Kuwait, and Iraq.\n#The counterchanged colors of the palets/vertical bars signify the various transformations of the unit to become the 396th Sustainment Brigade.\n#The poplar tree, adapted from the 369th Infantry Battalion’s coat of arms, indicates the Brigade perpetuating the lineage of the Battalion.   \n\n==Background==\n\n#The shoulder sleeve insignia was approved for the 369th Sustainment Brigade on 7 February 2008.\n\n== {{Original upload log}} ==\n{| class=\"wikitable\"\n|-\n! {{int:filehist-datetime}} !! {{int:filehist-dimensions}} !! {{int:filehist-user}} !! {{int:filehist-comment}}\n|-\n| {{ISOdate|2008-07-11 04:25:49}} || 809 × 1000 (24764 bytes) || {{User|Nobunaga24}} || ''<nowiki>{{Information&#10;|Description={{en|1=369th Sustainment Brigade shoulder sleeve insignia}}&#10;|Source=http://www.dmna.state.ny.us/facilities/unit_info.php?unit=Headquarters+369th+Sustainment+Brigade&#10;|Author=U.S. Army&#10;|Date=&#10;|Permission=&#10;|other_versions=&#10;}}&#10;&#10;{{Im</nowiki>''\n|}\n[[Category:Combat service identification badges of the United States Army]]"}}}]}]}}