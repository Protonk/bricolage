dia.org/w/index.php?curid=3588726","sha1":"1fef277bbac6d45750d87fc46f346d5b00ecf21c","extmetadata":{"DateTime":{"value":"2008-02-20 19:21:41","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"173AirborneBCTSSI","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"173rd Airborne Brigade Combat Team|PD US Army USAIOH|US Army Infantry Brigade Shoulder Sleeve Insignia","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"173rd Airborne Brigade Combat Team Shoulder Sleeve Insignia<sup id=\"cite_ref-”SSICSIB”_1-0\" class=\"reference\"><a href=\"#cite_note-%E2%80%9DSSICSIB%E2%80%9D-1\"><span class=\"cite-bracket\">[</span>1<span class=\"cite-bracket\">]</span></a></sup>.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1963-05-13","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"http://www.tioh.hqda.pentagon.mil/\">US Army Institute of Heraldry</a>","source":"commons-desc-page"},"Artist":{"value":"United States Army","source":"commons-desc-page"},"Permission":{"value":"US Army Institute of Heraldry","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"revisions":[{"revid":912830586,"parentid":744680299,"timestamp":"2024-08-20T07:22:44Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"== {{int:filedesc}} ==\n{{Information\n|Description={{en|1=173rd Airborne Brigade Combat Team Shoulder Sleeve Insignia<ref name=”SSICSIB”>The Shoulder Sleeve Insignia is worn on all uniforms except the Blue Service Uniform.<br>The Combat Service Identification Badge is a simplified miniature version of the SSI, and is worn on the Blue Service Uniform.</ref>.}}\n|Source= [http://www.tioh.hqda.pentagon.mil/ US Army Institute of Heraldry]\n|Author= {{en|1=United States Army}}\n|Date=1963-05-13\n|Permission= {{PD-USGov-Military-Army-USAIOH}} – {{en|1=US Army Institute of Heraldry}}\n|other_versions=\n}}\n\n\n==Shoulder Sleeve Insignia==\n\n*Description:\n#On a blue silhouetted right cylinder 3 inches (7.62 cm) in height and 2 inches (5.08 cm) in width overall within a 1/8 inch (.32 cm) white border a vertical white wing in flight, the ulna (lower end) extended and hooked around a red bayonet.\n#Attached above the insignia is a blue tab inscribed “AIRBORNE” in white.\n\n==Combat Service Identification Badge==\n\n*A silver color metal and enamel device 2 inches (5.08 cm) in height consisting of a design similar to the shoulder sleeve insignia.\n\n==Symbolism==\n#The bayonet is used to refer to the brigade being borne by the wing alludes to the brigade's airborne status.\n#Red, white and blue are the national colors.\n\n==Background==\n#The shoulder sleeve insignia was originally approved on [[1963-05-13]].\n#It was amended to correct the dimensions on [[1963-07-29]].\n#The insignia was amended to include the tab and update the description on [[2000-04-26]].\n#It was redesignated for the 173d Airborne Brigade Combat Team on [[2006-10-11]].\n#(TIOH Dwg. No. A-1-310)\n\n==Notes==\n{{Reflist}}\n\n[[Category:US Army Infantry Brigade Shoulder Sleeve Insignia]]\n[[Category:173rd Airborne Brigade Combat Team]]"}}}]},{"pageid":4608586,"ns":6,"title":"File:425TransBdeSSI.jpg","imagerepository":"local","imageinfo":[{"timestamp":"2008-08-22T22:44:59Z","user":"Nobunaga24","size":10474,"width":237,"height":237,"thumburl":"https://upload.wikimedia.org/wiki