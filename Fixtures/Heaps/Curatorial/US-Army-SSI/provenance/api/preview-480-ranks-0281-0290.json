h":192,"height":286,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/13/371SustainBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":322,"thumbheight":480,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/13/371SustainBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":322,"height":480},"url":"https://upload.wikimedia.org/wikipedia/commons/1/13/371SustainBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:371SustainBdeSSI.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=4113161","sha1":"fff76466d01612e3a3c09abd1ecf41629fcb4376","extmetadata":{"DateTime":{"value":"2008-05-26 01:23:31","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"371SustainBdeSSI","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Files with no machine-readable author|With insignia|PD US Army USAIOH|Tinctures not specified (nonSVG)|US Army Sustainment Brigade Shoulder Sleeve Insignia|371st Sustainment Brigade","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"DateTimeOriginal":{"value":"1 September 2007","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://web.archive.org/web/20080512030429/http://www.tioh.hqda.pentagon.mil:80/Sustain/371SustainmentBrigade.htm\">https://web.archive.org/web/20080512030429/http://www.tioh.hqda.pentagon.mil:80/Sustain/371SustainmentBrigade.htm</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"insignia","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"revisions":[{"revid":1022224593,"parentid":987599223,"timestamp":"2025-04-18T09:38:19Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"== {{int:filedesc}} ==\n{{COAInformation\n |blazon of   = {{Label|Q4635806}}\n |blazon      = {{en|On a buff vertical octagonal-shaped embroidered device, arcing outwardly at top and bottom, a blue wavy horizontal band bearing three buff stars, between in base an arrowhead and in chief a polestar, all red; all within a 1/8 inch (.32 cm) red border.  Overall dimensions are 2 inches (5.08 cm) in width and 3 inches (7.62 cm) in length.}}\n |references  =\n |tincture    =\n |description = {{en|Buff and red are the colors traditionally used by the Sustainment units.  The wavy band suggests water, alluding to a “large creek,” the meaning of the name Ohio and the location of the Brigade.  The three stars represent the unit’s campaign credits in World War I, World War II, and the Global War on Terrorism.  The arrowhead signifies the Brigade’s service in the fight for Luzon during World War II and the motto “Logistic Warriors.”  The polestar denotes the unit’s leadership to guide service members and deployment capabilities worldwide.}}\n |date        = 2007-09-01\n |artist      = {{Label|Q2579238}}\n |image       =\n |source      = https://web.archive.org/web/20080512030429/http://www.tioh.hqda.pentagon.mil:80/Sustain/371SustainmentBrigade.htm\n |permission  =\n |versions    =\n |fields      =\n}}\n\n== {{int:license-header}} ==\n{{PD-USGov-Military-Army-USAIOH}}\n{{Insignia}}\n\n== {{original upload log}} ==\n{{original description page|en.wikipedia|371SustainBdeSSI.jpg}}\n* 2007-04-27 10:37 [[:en:User:Mikeofv|Mikeofv]] 192×286×8 (7727 bytes) ''<nowiki>371st Shoulder patch</nowiki>''\n\n[[Category:US Army Sustainment Brigade Shoulder Sleeve Insignia]]\n[[Category:371st Sustainment Brigade]]"}}}]},{"pageid":4571031,"ns":6,"title":"File:3ChemicalBdeSSI.jpg","imagerepository":"local","imageinfo":[{"timestamp":"2010-04-06T03:11:37Z","user":"SGT141","size":196318,"width":766,"height":884,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/3ChemicalBdeSSI.jpg/500px-3ChemicalBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":416,"thumbheight":480,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/1/18/3ChemicalBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/3ChemicalBdeSSI.jpg/500px-3ChemicalBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":416,"height":480,"srcset":"https://upload.wikimedia.org/wikipedia/commons/1/18/3ChemicalBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/18/3ChemicalBdeSSI.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:3ChemicalBdeSSI.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=4571031","sha1":"7aca0a7c8c79dda68185cc10e2cf7d9ac91910f9","extmetadata":{"DateTime":{"value":"2010-04-06 03:11:37","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"3ChemicalBdeSSI","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Vector version available|PD US Army USAIOH|Number 3 on objects|US Army Chemical Brigade Shoulder Sleeve Insignia|Arrowheads in military insi