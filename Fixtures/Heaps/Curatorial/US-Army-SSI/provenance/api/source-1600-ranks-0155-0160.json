a.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:3_Corps_Shoulder_Sleeve_Insignia.svg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=1697779","sha1":"bbc6d4e0399a1bce5cd776261c5f197794d60a7e","extmetadata":{"DateTime":{"value":"2017-10-31 06:11:45","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"3 Corps Shoulder Sleeve Insignia","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Caltraps in heraldry|PD US Army USAIOH|US Army Corps Shoulder Sleeve Insignia|Valid SVG created with CorelDRAW:Emblems","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Shoulder sleeve insignia of the III Corps.\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\"><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1\"><a href=\"#Summary\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Summary</span></a></li>\n<li class=\"toclevel-1\"><a href=\"#Symbolism\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Symbolism</span></a></li>\n<li class=\"toclevel-1\"><a href=\"#Background\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Background</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Licensing\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Licensing</span></a></li>\n</ul>\n</div>\n\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Summary\">Summary</h2></div>\n<p>A blue caltrop with three points that lie on a circle of 1 1/2 inch radius with a white triangle in the center with points that lie on a circle of 3/8 inch radius. The design is enclosed by a 1/8 inch Army green border. \n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Symbolism\">Symbolism</h2></div>\n<p>The triangular design represents the numerical designation of the corps. The blue and white are the authorized colors used in distinguishing flags to represent corps.\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Background\">Background</h2></div>\nThe shoulder sleeve insignia was approved by the Adjutant General, American Expeditionary Force on December 3, 1918. It was approved by the War Department on June 17, 1922.","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span> with","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:VanHelsing.16\" title=\"User:VanHelsing.16\">User:VanHelsing.16</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/svg+xml"}],"revisions":[{"revid":955934689,"parentid":767899925,"timestamp":"2024-11-12T05:23:53Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","content":"{{Information\n|description    = {{en|Shoulder sleeve insignia of the III Corps.\n\n== {{int:filedesc}} ==\nA blue caltrop with three points that lie on a circle of 1 1/2 inch radius with a white triangle in the center with points that lie on a circle of 3/8 inch radius. The design is enclosed by a 1/8 inch Army green border. \n\n==Symbolism==\nThe triangular design represents the numerical designation of the corps. The blue and white are the authorized colors used in distinguishing flags to represent corps.\n\n==Background==\nThe shoulder sleeve insignia was approved by the Adjutant General, American Expeditionary Force on December 3, 1918. It was approved by the War Department on June 17, 1922.}}\n|source         = {{own}} with \n|date           = \n|author         = [[User:VanHelsing.16]]\n|other fields = {{Igen|D|+|s=e}}\n}}\n\n== {{int:license-header}} ==\n{{PD-USGov-Military-Army-USAIOH}}\n\n[[Category:US Army Corps Shoulder Sleeve Insignia|003]]\n[[Category:Caltraps in heraldry]]"}}}]},{"pageid":4050347,"ns":6,"title":"File:256 INF BDE SSI.gif","imagerepository":"local","imageinfo":[{"timestamp":"2010-03-27T04:24:54Z","user":"SGT141","size":84085,"width":619,"height":928,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/12/256_INF_BDE_SSI.gif?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1067,"thumbheight":1600,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/12/256_INF_BDE_SSI.gif?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1067,"height":1600},"url":"https://upload.wikimedia.org/wikipedia/commons/1/12/256_INF_BDE_SSI.gif?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:256_INF_BDE_SSI.gif","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=4050347","sha1":"a021066502fed6cb4001b34b4c3133e7347a46e8","extmetadata":{"DateTime":{"value":"2010-03-27 04:24:54","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"256 INF BDE SSI","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"256th Infantry Brigade Combat Team (United States)|Vector version available|PD US Army USAIOH|Combat service