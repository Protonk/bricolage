{
  "review_basis": "Actual acquired previews, file-specific Commons imageinfo/extmetadata and five local fixture inventories. Visual selection is distinct from source identity checking.",
  "relationship_reviews": [
    {
      "candidates": [
        "ps-0102",
        "ps-0107"
      ],
      "finding": "Same visible pair of fossil hills, NPS source and reported day. Retain ps-0102; defer ps-0107 as a possible related capture. No claim that distinct source GUIDs establish independence."
    },
    {
      "candidates": [
        "ps-0132",
        "ps-0135"
      ],
      "finding": "Same photographer Thomas Heins, consecutive reported December mornings, similar wooded-ridge setting and monochrome treatment. Exact shared location/session is unproven; retain ps-0132 and defer ps-0135 pending source clarification."
    },
