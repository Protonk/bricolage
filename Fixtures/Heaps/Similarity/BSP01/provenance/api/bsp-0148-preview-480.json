{"batchcomplete":true,"query":{"pages":[{"pageid":134929375,"ns":6,"title":"File:Algenmatte (auf Watt, Wangerooge).jpg","imagerepository":"local","imageinfo":[{"timestamp":"2023-07-25T10:13:58Z","user":"Rhetos","size":4260864,"width":4000,"height":2248,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg/500px-Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":480,"thumbheight":270,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg/960px-Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg/500px-Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":480,"height":270,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg/960px-Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/12/Algenmatte_%28auf_Watt%2C_Wangerooge%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Algenmatte_(auf_Watt,_Wangerooge).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=134929375","sha1":"b4d98995662264bea4ef78975e44723aaa663347","extmetadata":{"DateTime":{"value":"2023-07-25 10:13:58","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Algenmatte (auf Watt, Wangerooge)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"CC-Zero|Self-published work|Nature of Wangerooge|Algal mats","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Diese mattenartigen flächigen Gebilde kann man mühelos mit der Hand vom hellen und sandigen Wattboden aufnehmen. Die Matte selbst ist recht fest. Die Matte wird wahrscheinlich gebildet von verschiedenen Diatomeenarten, also Kieselalgen. Diese Kieselalgen gibt es in rundlichen wie auch eher länglichen Formen. Die Matten werden von den eher länglichen Formen gebildet.<br><br>\nDiese Matten finden sich vor allem in Bereichen, die weniger lange überflutet sind. Eventuell hängt das mit dem Angebot an Sonnenlicht zusammen. Die Diatomeen betreiben Photosynthese.<br><br>Ein zwei Jahre zuvor an ziemlich genau derselben Stelle aufgenommenes Bild zeigt die <a href=\"//commons.wikimedia.org/wiki/File:Algenmatte_(Wangerooge).png\" title=\"File:Algenmatte (Wangerooge).png\">Algenmatte auch von unten</a>.<br><br>Beachte auch, wie lang der Schatten des Fingers ist: die Sonne stand links sehr tief am Horizont, entsprechend lang waren die Schatten von Gegenständen. Der Schatten des Fingers reicht rechts von diesem bis über den rechten Bildrand hinaus.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2023-07-07 19:53:05","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Rhetos\" title=\"User:Rhetos\">Rhetos</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Zero, Public Domain Dedication","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]}]}}