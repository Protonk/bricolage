{
  "status": "complete",
  "review_basis": "Actual acquired previews, file-specific Commons imageinfo/extmetadata and six local fixture inventories containing 382 inputs. Visual selection is distinct from source identity checking.",
  "relationship_reviews": [
    {
      "candidates": [
        "cr-0032",
        "cr-0040"
      ],
      "finding": "Same visible brise-soleil facade, creator Wilfredor and exact reported capture timestamp 2016-12-04 16:09:56. Different upstream SHA-1s do not make these independent. Retain cr-0032 and reject cr-0040 as a related representation."
    },
    {
      "candidates": [
        "cr-0007",
        "cr-0008"
      ],
      "finding": "Same photographer Dietmar Rabich and Bonn parliamentary-building context, reported four minutes apart on 2017-08-20. Different named buildings are visible, but a related outing is plausible; retain cr-0008 and defer cr-0007 pending clarification. This does not establish that they share a capture."
    },
    {
      "candidates": [
        "cr-0100",
        "cr-0101",
        "cr-0102"
      ],
      "finding": "Same photographer Maryland Pride and Northwestern High School. Metadata describes different wings/floors and dates in August 2009 and August 2010; these differences do not prove independence. cr-0100 is visually rejected; retain cr-0101 and defer visually suitable cr-0102 as an unresolved same-school relationship."
    },
    {
      "candidates": [
        "cr-0128",
        "cr-0129"
      ],
      "finding": "Same photographer PeaceSeekers and Universiti Malaya Library, with reported capture timestamps 2023-11-15 12:28:54 and 12:29:07. A clear paired library sequence. Retain the neutral black-journal view cr-0128; reject cr-0129, which also fails the cool palette."
    },
    {
      "candidates": [
        "cr-0008",
        "cr-0013",
        "cr-0017",
        "cr-0023"
      ],
      "finding": "Same credited photographer Dietmar Rabich. Actual previews and descriptions show distinct Bonn, Düsseldorf, Hamburg and Seattle buildings, with reported years 2017, 2015, 2016 and 2022. No shared capture identified; metadata differences alone do not prove independence."
    },
    {
      "candidates": [
        "cr-0032",
        "cr-0033",
        "cr-0034",
        "cr-0043"
      ],
      "finding": "Same credited photographer Wilfredor. The three Paulista-area selections show different facades and reported dates 2016-12-04, 2014-10-19 and 2016-05-27; cr-0043 is a Caracas building reported in 2013. No shared capture identified among these retained images. The matching facade/timestamp of rejected cr-0040 is handled above."
    },
    {
      "candidates": [
        "cr-0099",
        "cr-0116"
      ],
      "finding": "Same credited photographer Globetrotter19. Lockers in a Semmelweis University corridor and rooftop panels at the National Institute of Oncology are visibly different settings, with reported dates 2024-05-12 and 2026-05-09. No common capture identified; independence is not proved."
    },
    {
      "candidates": [
        "cr-0067",
        "cr-0141",
        "cr-0142"
      ],
      "finding": "Creator variants Photo by Joe Mabel and Joe Mabel refer to the same photographer. Selected cr-0067 shows Harbor Island containers in 2023; selected cr-0142 shows Talking Book & Braille Library stacks in 2009. cr-0141 shares cr-0142 location and reported day, and is visually rejected. No common capture identified between the two retained images."
    },
    {
      "candidates": [
        "cr-0154"
      ],
      "other_fixture_candidates": [
        "ps-0067"
      ],
      "finding": "Shared creator RhinoMind with PS01. Compared both acquired previews: Aarhus hotel facade versus foggy meadow. Metadata reports 2017-09-18 versus 2013-12-09; no common capture identified."
    },
    {
      "candidates": [
        "cr-0096",
        "cr-0155",
        "cr-0161",
        "cr-0167"
      ],
      "finding": "Numbered titles or supplied notes indicate potential wider series. Only one lead for each represented series is retained; no exhaustive upstream sequence search was performed."
    },
    {
      "candidates": [
        "cr-0133"
      ],
      "finding": "Narrow-format library photograph. Description calls it a slim shot of library shelves and credits own work. No specific alternate crop or source image identified in the available evidence; narrow framing alone is not evidence of a derivative."
